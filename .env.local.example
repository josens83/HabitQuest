# Copy this file to .env.local and fill in your actual values
# .env.local is already in .gitignore and will not be committed

# Quick Start (Minimal Configuration)
DATABASE_URL="postgresql://habitquest:habitquest_dev_password@localhost:5432/habitquest_dev"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-secret-change-in-production"

# For development, you can skip OAuth providers initially
# The app will work with email/password authentication
