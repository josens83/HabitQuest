# Database
DATABASE_URL="postgresql://user:password@localhost:5432/habitquest?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (카카오, 구글, 애플)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Redis (optional - for caching and leaderboards)
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (optional - for image storage)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Analytics (optional)
MIXPANEL_TOKEN=""
# or
POSTHOG_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# Firebase Cloud Messaging (optional - for push notifications)
FCM_SERVER_KEY=""

# Stripe (optional - for payment processing)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Environment
NODE_ENV="development"
